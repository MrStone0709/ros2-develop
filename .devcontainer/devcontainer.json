// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "rmcs-develop",
	"image": "qzhhhi/rmcs-develop:latest",
	"privileged": true,
	"mounts": [
		{
			"source": "/dev",
			"target": "/dev",
			"type": "bind"
		},
		{
			"source": "/tmp/.X11-unix",
			"target": "/tmp/.X11-unix",
			"type": "bind"
		}
	],
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}"
	},
	"runArgs": [
		"--network",
		"host"
	],
	// 容器启动时在后台拉起 foxglove_bridge（默认端口 8766）。
	// 8765 被 Windows 上的 Clash Verge 占用，故改用 8766。
	"postStartCommand": "bash -lc 'source /opt/ros/jazzy/setup.bash && nohup ros2 run foxglove_bridge foxglove_bridge --ros-args -p port:=8766 > /tmp/foxglove_bridge.log 2>&1 &'",
	"customizations": {
		"vscode": {
			"extensions": [
				// C++ language support
				"llvm-vs-code-extensions.vscode-clangd",
				// Python language support
				"ms-python.vscode-pylance",
				"ms-python.python",
				"ms-python.debugpy",
				// CMake language support
				"twxs.cmake",
				// Code spell checking
				"streetsidesoftware.code-spell-checker",
				// Git enhancements
				"mhutchie.git-graph"
			]
		}
	}
}